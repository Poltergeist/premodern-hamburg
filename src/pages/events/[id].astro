---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEventById, getDecklistsForEvent, getStandingsForEvent, events } from '../../data/events';

export async function getStaticPaths() {
  return events.map(event => ({
    params: { id: event.id },
  }));
}

const { id } = Astro.params;
const event = getEventById(id);

if (!event) {
  return Astro.redirect('/404');
}

const decklists = getDecklistsForEvent(event.id);
const standings = getStandingsForEvent(event.id);
const WORKER_URL = import.meta.env.DEV
  ? "http://localhost:8788"
  : "https://premodern-decklist-api.premodern-hamburg.workers.dev";
const GOOGLE_CLIENT_ID = import.meta.env.PUBLIC_GOOGLE_OAUTH_CLIENT_ID || "";
---

<BaseLayout title={event.name}>
  <div class="event-detail">
    <div class="breadcrumb">
      <a href={`${import.meta.env.BASE_URL}`}>← Zurück zu allen Events</a>
    </div>

    <div class="event-hero card">
      <div class="event-status-bar">
        <span class="status-badge {event.status}">
          {event.status === 'upcoming' ? '📅 Upcoming' : event.status === 'completed' ? '✓ Abgeschlossen' : '❌ Abgesagt'}
        </span>
        <span class="category-badge">{event.category}</span>
      </div>

      <h1>{event.name}</h1>
      
      <div class="event-meta">
        <div class="meta-item large">
          <span class="meta-icon">📅</span>
          <div>
            <div class="meta-label">Datum & Zeit</div>
            <div class="meta-value">{event.date}</div>
          </div>
        </div>

        <div class="meta-item large">
          <span class="meta-icon">📍</span>
          <div>
            <div class="meta-label">Location</div>
            <div class="meta-value">{event.location.name}</div>
            <div class="meta-subtext">{event.location.address}</div>
            {event.location.url && (
              <a href={event.location.url} target="_blank" rel="noopener" class="location-link">
                Webseite →
              </a>
            )}
          </div>
        </div>
      </div>
    </div>

    <div class="content-grid">
      <div class="main-content">
        <div class="card">
          <h2>📝 Über das Event</h2>
          <p class="description">{event.description}</p>
        </div>

        <div class="card">
          <h2>🎮 Format & Regeln</h2>
          <div class="format-info">
            <div class="info-item">
              <span class="info-label">Format:</span>
              <span class="info-value">{event.format}</span>
            </div>
            <div class="format-description">
              <p>
                PreModern ist ein Eternal-Format für Magic: The Gathering, das Karten von 1995 bis 2003 umfasst 
                (4th Edition bis Scourge). Erlebe die Nostalgie klassischer Magic-Karten ohne die Power 9!
              </p>
            </div>
          </div>
        </div>
        {event.status !== 'cancelled' && (
        <div class="card" id="decklists-section" style={event.status === 'upcoming' ? 'display: none;' : ''} data-event-datetime={event.datetime}>
          <h2>📋 Decklisten</h2>

          {decklists.length > 0 ? (
            <ul class="decklist-list">
              {decklists.map((d) => (
                <li class="decklist-entry">
                  <span class="decklist-player">
                    {d.rank ? `#${d.rank} — ` : ''}{d.player}
                  </span>
                  <a href={d.url} target="_blank" rel="noopener" class="decklist-link">
                    {d.url.includes('moxfield.com') ? 'Moxfield' : d.url.includes('archidekt.com') ? 'Archidekt' : 'MTGGoldfish'} →
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="no-decklists">Noch keine Decklisten eingereicht.</p>
          )}

          <button id="toggle-form-btn" class="btn" style="margin-top: 1.5rem;">
            Decklist einreichen
          </button>

          <div id="decklist-form" class="decklist-form" style="display: none;">
            <div class="form-group">
              <label for="player-name">Spielername</label>
              <input type="text" id="player-name" placeholder="Dein Name" required />
            </div>

            <div class="form-group">
              <label for="player-rank">Platzierung (optional)</label>
              <input type="number" id="player-rank" min="1" placeholder="z.B. 1" />
            </div>

            <div class="form-group">
              <label for="deck-url">Deck URL</label>
              <input
                type="url"
                id="deck-url"
                placeholder="https://www.moxfield.com/decks/..."
                required
              />
              <span class="form-hint">Moxfield, Archidekt oder MTGGoldfish Link</span>
            </div>

            <div id="captcha-section" class="form-group">
              <label>Wie heißt diese Karte?</label>
              <div id="captcha-loading" class="captcha-loading">Karte wird geladen...</div>
              <img id="captcha-image" class="captcha-image" style="display: none;" alt="Premodern card" />
              <button id="refresh-captcha" class="captcha-refresh" style="display: none;" type="button">
                Andere Karte
              </button>
              <input type="text" id="card-name" placeholder="Kartenname eingeben" required />
            </div>

            <button id="submit-decklist" class="btn" style="width: 100%;">
              Absenden
            </button>

          </div>

          <div id="form-status" class="form-status" style="display: none;"></div>
        </div>
        )}

        {event.status === 'completed' && (
        <div class="card" id="standings-section" data-event-id={event.id}>
          <h2>🏆 Standings</h2>

          {standings.length > 0 ? (
            <div class="standings-table-wrapper">
              <table class="standings-table">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Spieler</th>
                    <th>Punkte</th>
                    <th>OW%</th>
                    <th>GW%</th>
                    <th>OGW%</th>
                  </tr>
                </thead>
                <tbody>
                  {standings.map((s) => (
                    <tr>
                      <td>{s.rank}</td>
                      <td>{s.player}</td>
                      <td>{s.points}</td>
                      <td>{s.owp}</td>
                      <td>{s.gwp}</td>
                      <td>{s.ogwp}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <p class="no-standings">Noch keine Standings vorhanden.</p>
          )}

          {standings.length === 0 && (
            <>
              <button id="admin-signin" class="admin-link" style="margin-top: 1.5rem;">
                Standings hochladen
              </button>

              <div id="admin-upload" style="display: none; margin-top: 1.5rem;">
                <label class="file-input-wrapper">
                  <span class="file-input-label" id="file-label">CSV-Datei auswählen...</span>
                  <input type="file" id="standings-csv" accept=".csv" class="file-input-hidden" />
                </label>
                <button id="upload-standings" class="btn" style="width: 100%; margin-top: 0.75rem;">
                  Hochladen
                </button>
              </div>

              <div id="standings-status" class="form-status" style="display: none;"></div>
            </>
          )}
        </div>
        )}

      </div>

      <div class="sidebar">
        { event.status === 'upcoming' && (
        <div class="card info-card">
          <h3>💰 Teilnahme</h3>
          <div class="info-grid">
            {event.entryFee && (
              <div class="info-row">
                <span class="info-icon">💵</span>
                <div>
                  <div class="info-label">Entry Fee</div>
                  <div class="info-value">{event.entryFee}</div>
                </div>
              </div>
            )}
            
            {event.prizes && (
              <div class="info-row">
                <span class="info-icon">🏆</span>
                <div>
                  <div class="info-label">Preise</div>
                  <div class="info-value">{event.prizes}</div>
                </div>
              </div>
            )}
          </div>

          {event.registrationLink && (
            <a href={event.registrationLink} class="btn" style="margin-top: 1.5rem; width: 100%;">
              Jetzt anmelden
            </a>
          )}
        </div>
        )}

        <div class="card info-card">
          <h3>ℹ️ Wichtige Infos</h3>
          <ul class="info-list">
            <li>Freundliche Atmosphäre für Anfänger</li>
            <li>Snacks & Getränke verfügbar</li>
          </ul>
        </div>

      </div>
    </div>
  </div>

  <style>
    .event-detail {
      max-width: 1200px;
      margin: 0 auto;
    }

    .breadcrumb {
      margin-bottom: 2rem;
    }

    .breadcrumb a {
      color: var(--color-text-muted);
      text-decoration: none;
      transition: color 0.2s;
    }

    .breadcrumb a:hover {
      color: var(--color-blue);
    }

    .event-hero {
      margin-bottom: 2rem;
      padding: 2.5rem;
    }

    .event-status-bar {
      display: flex;
      gap: 1rem;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
    }

    .status-badge {
      padding: 0.5rem 1rem;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.9rem;
    }

    .status-badge.upcoming {
      background: rgba(63, 185, 80, 0.1);
      color: var(--color-green);
      border: 1px solid var(--color-green);
    }

    .status-badge.completed {
      background: rgba(139, 148, 158, 0.1);
      color: var(--color-text-muted);
      border: 1px solid var(--color-border);
    }

    .category-badge {
      padding: 0.5rem 1rem;
      border-radius: 8px;
      background: var(--color-medium-gray);
      color: var(--color-text-muted);
      font-size: 0.9rem;
      border: 1px solid var(--color-border);
    }

    .event-hero h1 {
      margin-bottom: 2rem;
      background: var(--gradient-magic);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .event-meta {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 2rem;
    }

    .meta-item {
      display: flex;
      gap: 1rem;
      align-items: start;
    }

    .meta-icon {
      font-size: 2rem;
    }

    .meta-label {
      font-size: 0.85rem;
      color: var(--color-text-muted);
      margin-bottom: 0.25rem;
    }

    .meta-value {
      font-size: 1.1rem;
      font-weight: 600;
      color: var(--color-text);
    }

    .meta-subtext {
      font-size: 0.9rem;
      color: var(--color-text-muted);
      margin-top: 0.25rem;
    }

    .location-link {
      display: inline-block;
      margin-top: 0.5rem;
      color: var(--color-blue);
      text-decoration: none;
      font-size: 0.9rem;
    }

    .location-link:hover {
      text-decoration: underline;
    }

    .content-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    @media (min-width: 968px) {
      .content-grid {
        grid-template-columns: 2fr 1fr;
      }
    }

    .main-content {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .sidebar {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .description {
      color: var(--color-text);
      line-height: 1.8;
      font-size: 1.1rem;
    }

    .format-info {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .info-item {
      display: flex;
      gap: 0.5rem;
      padding: 1rem;
      background: var(--color-medium-gray);
      border-radius: 8px;
      border: 1px solid var(--color-border);
    }

    .info-label {
      color: var(--color-text-muted);
      font-weight: 600;
    }

    .info-value {
      color: var(--color-text);
    }

    .format-description {
      color: var(--color-text-muted);
      line-height: 1.6;
    }

    .info-card {
      padding: 1.5rem;
    }

    .info-card h3 {
      margin-bottom: 1.5rem;
      font-size: 1.2rem;
    }

    .info-grid {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .info-row {
      display: flex;
      gap: 1rem;
      align-items: start;
    }

    .info-icon {
      font-size: 1.5rem;
    }

    .info-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .info-list li {
      padding-left: 1.5rem;
      position: relative;
      color: var(--color-text-muted);
    }

    .info-list li::before {
      content: '✓';
      position: absolute;
      left: 0;
      color: var(--color-green);
      font-weight: bold;
    }

    /* Decklists */
    .decklist-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .decklist-entry {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.75rem 1rem;
      background: var(--color-medium-gray);
      border-radius: 8px;
      border: 1px solid var(--color-border);
    }

    .decklist-player {
      font-weight: 600;
      color: var(--color-text);
    }

    .decklist-link {
      color: var(--color-blue);
      text-decoration: none;
      font-size: 0.9rem;
    }

    .decklist-link:hover {
      text-decoration: underline;
    }

    .no-decklists {
      color: var(--color-text-muted);
      font-style: italic;
    }

    /* Decklist form */
    .decklist-form {
      margin-top: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .form-group label {
      font-weight: 600;
      color: var(--color-text);
      font-size: 0.95rem;
    }

    .form-group input[type="text"],
    .form-group input[type="url"],
    .form-group input[type="number"] {
      padding: 0.75rem 1rem;
      border-radius: 8px;
      border: 1px solid var(--color-border);
      background: var(--color-medium-gray);
      color: var(--color-text);
      font-size: 1rem;
      transition: border-color 0.2s;
    }

    .form-group input:focus {
      outline: none;
      border-color: var(--color-blue);
    }

    .form-hint {
      font-size: 0.8rem;
      color: var(--color-text-muted);
    }

    .captcha-loading {
      color: var(--color-text-muted);
      font-style: italic;
      padding: 1rem 0;
    }

    .captcha-image {
      max-width: 300px;
      border-radius: 12px;
      border: 1px solid var(--color-border);
    }

    .captcha-refresh {
      background: none;
      border: none;
      color: var(--color-blue);
      cursor: pointer;
      font-size: 0.85rem;
      padding: 0.25rem 0;
      text-align: left;
    }

    .captcha-refresh:hover {
      text-decoration: underline;
    }

    .form-status {
      margin-top: 1.5rem;
      padding: 1rem;
      border-radius: 8px;
      font-weight: 500;
    }

    .form-status.success {
      background: rgba(63, 185, 80, 0.1);
      color: var(--color-green);
      border: 1px solid var(--color-green);
    }

    .form-status.error {
      background: rgba(248, 81, 73, 0.1);
      color: var(--color-red);
      border: 1px solid var(--color-red);
    }

    /* Standings */
    .standings-table-wrapper {
      overflow-x: auto;
    }

    .standings-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.95rem;
    }

    .standings-table th,
    .standings-table td {
      padding: 0.6rem 0.75rem;
      text-align: left;
      border-bottom: 1px solid var(--color-border);
    }

    .standings-table th {
      color: var(--color-text-muted);
      font-weight: 600;
      font-size: 0.85rem;
      white-space: nowrap;
    }

    .standings-table td:first-child,
    .standings-table th:first-child {
      text-align: center;
      width: 3rem;
    }

    .standings-table td:nth-child(n+3),
    .standings-table th:nth-child(n+3) {
      text-align: right;
      white-space: nowrap;
    }

    .standings-table tbody tr:hover {
      background: var(--color-medium-gray);
    }

    .no-standings {
      color: var(--color-text-muted);
      font-style: italic;
    }

    .admin-link {
      background: none;
      border: none;
      color: var(--color-text-muted);
      cursor: pointer;
      font-size: 0.8rem;
      padding: 0;
      opacity: 0.5;
      transition: opacity 0.2s;
    }

    .admin-link:hover {
      opacity: 1;
      text-decoration: underline;
    }

    .file-input-wrapper {
      display: block;
      padding: 0.75rem 1rem;
      border-radius: 8px;
      border: 1px dashed var(--color-border);
      background: var(--color-medium-gray);
      cursor: pointer;
      text-align: center;
      transition: border-color 0.2s;
    }

    .file-input-wrapper:hover {
      border-color: var(--color-blue);
    }

    .file-input-wrapper.has-file {
      border-style: solid;
      border-color: var(--color-green);
    }

    .file-input-label {
      color: var(--color-text-muted);
      font-size: 0.9rem;
    }

    .file-input-wrapper.has-file .file-input-label {
      color: var(--color-text);
    }

    .file-input-hidden {
      display: none;
    }
  </style>

  <script is:inline define:vars={{ WORKER_URL, eventId: event.id, GOOGLE_CLIENT_ID }}>
    // Show decklists section for upcoming events once the event has started
    const decklistsSection = document.getElementById("decklists-section");
    if (decklistsSection && decklistsSection.style.display === "none") {
      const eventDatetime = new Date(decklistsSection.dataset.eventDatetime);
      if (new Date() >= eventDatetime) {
        decklistsSection.style.display = "";
      }
    }

    const toggleBtn = document.getElementById("toggle-form-btn");
    const form = document.getElementById("decklist-form");
    const captchaLoading = document.getElementById("captcha-loading");
    const captchaImage = document.getElementById("captcha-image");
    const refreshCaptcha = document.getElementById("refresh-captcha");
    const submitBtn = document.getElementById("submit-decklist");
    const statusEl = document.getElementById("form-status");

    let challengeId = null;
    const playerInput = document.getElementById("player-name");
    const savedName = localStorage.getItem("premodern-player-name");
    if (savedName && playerInput) playerInput.value = savedName;

    if (toggleBtn && form) {
      toggleBtn.addEventListener("click", () => {
        const isHidden = form.style.display === "none";
        form.style.display = isHidden ? "flex" : "none";
        toggleBtn.textContent = isHidden ? "Abbrechen" : "Decklist einreichen";
        if (isHidden) loadChallenge();
      });
    }

    async function loadChallenge() {
      captchaLoading.style.display = "block";
      captchaImage.style.display = "none";
      refreshCaptcha.style.display = "none";
      challengeId = null;

      try {
        const res = await fetch(WORKER_URL + "/challenge");
        const data = await res.json();
        if (data.error) throw new Error(data.error);

        challengeId = data.challengeId;
        captchaImage.src = data.imageUrl;
        captchaImage.style.display = "block";
        refreshCaptcha.style.display = "inline";
        captchaLoading.style.display = "none";
      } catch (err) {
        captchaLoading.textContent = "Fehler beim Laden der Karte. Bitte erneut versuchen.";
      }
    }

    if (refreshCaptcha) {
      refreshCaptcha.addEventListener("click", loadChallenge);
    }

    if (submitBtn) {
      submitBtn.addEventListener("click", async () => {
        const player = document.getElementById("player-name").value.trim();
        const rankVal = document.getElementById("player-rank").value;
        const rank = rankVal ? parseInt(rankVal, 10) : undefined;
        const deckUrl = document.getElementById("deck-url").value.trim();
        const cardName = document.getElementById("card-name").value.trim();

        if (!player || !deckUrl || !cardName || !challengeId) {
          showStatus("Bitte alle Felder ausfüllen.", "error");
          return;
        }

        const urlPattern = /^https:\/\/(www\.)?(moxfield\.com\/decks\/|archidekt\.com\/decks\/|mtggoldfish\.com\/deck\/)/;
        if (!urlPattern.test(deckUrl)) {
          showStatus("Bitte einen gültigen Moxfield, Archidekt oder MTGGoldfish Link eingeben.", "error");
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = "Wird gesendet...";

        try {
          const res = await fetch(WORKER_URL + "/submit", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ challengeId, cardName, eventId, player, deckUrl, rank }),
          });
          const data = await res.json();

          if (data.success) {
            localStorage.setItem("premodern-player-name", player);
            document.getElementById("player-rank").value = "";
            document.getElementById("deck-url").value = "";
            document.getElementById("card-name").value = "";
            form.style.display = "none";
            toggleBtn.textContent = "Decklist einreichen";
            showStatus("Decklist erfolgreich eingereicht! Sie wird nach einer kurzen Prüfung hier angezeigt.", "success");
          } else {
            showStatus(data.error || "Fehler beim Senden.", "error");
            if (data.error && data.error.includes("card name")) {
              loadChallenge();
            }
          }
        } catch {
          showStatus("Netzwerkfehler. Bitte erneut versuchen.", "error");
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = "Absenden";
        }
      });
    }

    function showStatus(msg, type) {
      statusEl.textContent = msg;
      statusEl.className = "form-status " + type;
      statusEl.style.display = "block";
    }

    // Standings upload
    const adminSignin = document.getElementById("admin-signin");
    const adminUpload = document.getElementById("admin-upload");
    const uploadBtn = document.getElementById("upload-standings");
    const standingsStatus = document.getElementById("standings-status");
    let standingsIdToken = null;

    function loadGIS() {
      return new Promise((resolve) => {
        if (window.google && window.google.accounts) { resolve(); return; }
        const s = document.createElement("script");
        s.src = "https://accounts.google.com/gsi/client";
        s.onload = resolve;
        document.head.appendChild(s);
      });
    }

    function showStandingsStatus(msg, type) {
      standingsStatus.textContent = msg;
      standingsStatus.className = "form-status " + type;
      standingsStatus.style.display = "block";
    }

    if (adminSignin && GOOGLE_CLIENT_ID) {
      adminSignin.addEventListener("click", async () => {
        await loadGIS();
        google.accounts.id.initialize({
          client_id: GOOGLE_CLIENT_ID,
          callback: function(response) {
            standingsIdToken = response.credential;
            adminSignin.style.display = "none";
            adminUpload.style.display = "block";
          },
        });
        google.accounts.id.prompt();
      });
    }

    const fileInput = document.getElementById("standings-csv");
    const fileLabel = document.getElementById("file-label");
    if (fileInput && fileLabel) {
      fileInput.addEventListener("change", () => {
        const name = fileInput.files[0]?.name;
        if (name) {
          fileLabel.textContent = name;
          fileInput.closest(".file-input-wrapper").classList.add("has-file");
        } else {
          fileLabel.textContent = "CSV-Datei auswählen...";
          fileInput.closest(".file-input-wrapper").classList.remove("has-file");
        }
      });
    }

    if (uploadBtn) {
      uploadBtn.addEventListener("click", async () => {
        const fileInput = document.getElementById("standings-csv");
        const file = fileInput && fileInput.files[0];
        if (!file || !standingsIdToken) {
          showStandingsStatus("Bitte eine CSV-Datei auswählen.", "error");
          return;
        }

        uploadBtn.disabled = true;
        uploadBtn.textContent = "Wird hochgeladen...";

        try {
          const formData = new FormData();
          formData.append("eventId", eventId);
          formData.append("file", file);

          const res = await fetch(WORKER_URL + "/standings", {
            method: "POST",
            headers: { "Authorization": "Bearer " + standingsIdToken },
            body: formData,
          });
          const data = await res.json();

          if (data.success) {
            showStandingsStatus("Standings erfolgreich hochgeladen! (" + data.rowCount + " Einträge)", "success");
            adminUpload.style.display = "none";
          } else {
            showStandingsStatus(data.error || "Fehler beim Hochladen.", "error");
          }
        } catch {
          showStandingsStatus("Netzwerkfehler. Bitte erneut versuchen.", "error");
        } finally {
          uploadBtn.disabled = false;
          uploadBtn.textContent = "Hochladen";
        }
      });
    }
  </script>
</BaseLayout>
